#pragma once
// Copy to config.h and fill in. config.h is gitignored.

// --- WiFi (both are tried; WiFiMulti joins whichever is strongest where the puck sits) ---
#define WIFI_SSID          "your-ssid"
#define WIFI_PASSWORD      "your-password"
#define WIFI_SSID_ALT      "your-extender-ssid"      // extender
#define WIFI_PASSWORD_ALT  "your-extender-password"

// --- Server (Fly voice backend) ---
#define WS_HOST  "jared-voice.fly.dev"
#define WS_PORT  443
#define WS_PATH  "/ws/audio"
#define WS_TLS   true        // wss://

// --- I2S mic wiring (from the proven ESP32-AudioRelay setup) ---
#define I2S_SCK_PIN  14      // BCLK / SCK
#define I2S_WS_PIN   15      // WS / LRCL
#define I2S_SD_PIN   32      // SD / DOUT (data out of mic -> ESP32 in)
#define I2S_MIC_CHANNEL  I2S_CHANNEL_FMT_ONLY_RIGHT  // INMP441 data is on RIGHT at 32-bit
