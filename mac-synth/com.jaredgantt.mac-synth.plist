<?xml version="1.0" encoding="UTF-8"?>
<!-- Mac synth server (warm Kokoro → PCM) for the synth-on-Mac path. Install:
       cp mac-synth/com.jaredgantt.mac-synth.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.jaredgantt.mac-synth.plist
     Then enable the feature with the hub setting synth_on_mac=1. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jaredgantt.mac-synth</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jaredgantt/voice/mac/.venv-kokoro/bin/python</string>
        <string>/Users/jaredgantt/repos/voice-pipeline/mac-synth/synth_server.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/mac-synth.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mac-synth.err.log</string>
</dict>
</plist>
