[Unit]
Description=Desk command consumer (Pi — starts Claude sessions when the Mac is away)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jaredgantt
WorkingDirectory=/home/jaredgantt/voice-pipeline/pi-desk
ExecStart=/home/jaredgantt/voice-pipeline/pi-desk/run.sh
Restart=always
RestartSec=5
Environment=HOME=/home/jaredgantt
# tmux and gh live in /usr/bin; claude in /usr/local/bin.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
