[Unit]
Description=Desk command consumer (Pi — starts Claude sessions when the Mac is away)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jaredgantt
WorkingDirectory=/home/jaredgantt/voice-pipeline/pi-desk
ExecStart=/home/jaredgantt/voice-pipeline/pi-desk/run.sh
Restart=always
RestartSec=5
# Kill ONLY this daemon on stop, never its descendants. systemd defaults to KillMode=control-group,
# which kills every process in the cgroup — and the tmux server is a child of this process despite
# being spawned detached. That meant restarting the daemon destroyed every session it was managing,
# silently, on every deploy. Sessions must outlive their supervisor; that is the point of tmux.
KillMode=process
# The unit's cgroup is handed to pi-desk to divide (cgroups.js): the supervisor and tmux server in
# one child with its own ceiling, each session in another with its own budget and ceiling, so one
# session's memory can be watched, capped and cleaned up on its own. No MemoryHigh/MemoryMax on the
# unit as a whole: a single ceiling over every session throttled and then killed whichever session it
# landed on, mid-turn, however small its own share. pi-desk's admission (shortfall in index.js) keeps
# the sum of every session's budget inside what the Pi has free.
Delegate=yes
# A session being OOM-killed must NOT take the unit down with it: the default (stop) would end the
# supervisor and every other session over one casualty, turning a contained loss into a total one.
OOMPolicy=continue
Environment=HOME=/home/jaredgantt
# tmux and gh live in /usr/bin; claude in /usr/local/bin.
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
